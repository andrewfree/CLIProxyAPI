{
  "schema_version": 1,
  "instance_root": "/home/andrew/cliproxy",
  "config_file": "config.yaml",
  "config_owner": "andrew:andrew",
  "config_mode": "600",
  "tailnet_forward": {
    "target": "127.0.0.1:8317",
    "listeners": [
      "100.98.74.67%tailscale0:8317",
      "[fd7a:115c:a1e0::7a2d:4a44]%tailscale0:8317"
    ]
  },
  "required_config": {
    "request-retry": 3,
    "max-retry-credentials": 0,
    "max-retry-interval": 75,
    "routing.strategy": "round-robin",
    "plugins.enabled": true,
    "plugins.configs.auth-cursor.enabled": true,
    "request-log": true,
    "logging-to-file": true,
    "logs-max-total-size-mb": 1024,
    "usage-statistics-enabled": false,
    "quota-cooldown-max-seconds": 3600,
    "save-cooldown-status": true,
    "routing.session-affinity": true,
    "routing.session-affinity-ttl": "1h",
    "routing.session-affinity-subagents": false,
    "routing.session-affinity-rebind-on": "any"
  },
  "required_mounts": [
    {
      "source": "/home/andrew/cliproxy/config.yaml",
      "target": "/CLIProxyAPI/config.yaml"
    },
    {
      "source": "/home/andrew/cliproxy/auths",
      "target": "/root/.cli-proxy-api"
    },
    {
      "source": "/home/andrew/cliproxy/logs",
      "target": "/CLIProxyAPI/logs"
    },
    {
      "source": "/home/andrew/cliproxy/plugins",
      "target": "/CLIProxyAPI/plugins"
    }
  ],
  "compose_policy": {
    "pull_policy": "never",
    "restart": "always",
    "stop_grace_period": "20s",
    "logging_driver": "json-file",
    "logging_max_size": "10m",
    "logging_max_file": "3"
  }
}
