[Unit]
Description=Check the Will CLIProxy log mover heartbeat and destination mount

[Service]
Type=oneshot
User=andrew
Group=andrew
UMask=0077
NoNewPrivileges=yes
RuntimeDirectory=cliproxy-will-log-mover-watchdog
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=WILL_LOG_MOVER_ARCHIVE_ROOT=%i
EnvironmentFile=/etc/cliproxy-will-log-mover.env
ExecStart=/usr/bin/python3.14 -I -B /usr/local/lib/cliproxy-will-log-mover/will_log_mover.py --watchdog
TimeoutStartSec=15s
