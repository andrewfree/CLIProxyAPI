[Unit]
Description=Check the continuous Will CLIProxy log mover heartbeat and destination mount
After=cliproxy-will-log-mover-continuous@%i.service

[Service]
Type=exec
User=andrew
Group=andrew
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
Environment=WILL_LOG_MOVER_ARCHIVE_ROOT=%i
EnvironmentFile=/etc/cliproxy-will-log-mover.env
ExecStart=/usr/bin/python3.14 -I -B /usr/local/lib/cliproxy-will-log-mover/will_log_mover.py --watchdog --continuous
Restart=on-failure
RestartSec=15s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
