[Unit]
Description=Copy Will CLIProxy request logs to disk12 during the retention pilot
After=local-fs.target
RequiresMountsFor=/srv/share/drives/disk12

[Service]
Type=exec
User=andrew
Group=andrew
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/home/andrew/cliproxy/logs
ReadWritePaths=-/srv/share/drives/disk12/%i/will/requests -/srv/share/drives/disk12/%i/meta
RuntimeDirectory=cliproxy-will-log-mover
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Environment=WILL_LOG_MOVER_ARCHIVE_ROOT=%i
EnvironmentFile=/etc/cliproxy-will-log-mover.env
ExecStart=/usr/bin/python3.14 -I -B /usr/local/lib/cliproxy-will-log-mover/will_log_mover.py
ExecStopPost=+/usr/bin/python3.14 -I -B /usr/local/lib/cliproxy-will-log-mover/will_log_mover.py --stop-post
LimitNOFILE=1024
LimitCORE=0
TimeoutStopSec=90s
RuntimeMaxSec=24h1min
