<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rever.cliproxy-log-archive</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/rever/cliproxy/ops/archive_logs.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/rever/cliproxy</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLIPROXY_LOG_ARCHIVE_MOUNT</key>
        <string>/Users/rever/Volumes/TheCloud</string>
        <key>CLIPROXY_LOG_ARCHIVE_ROOT</key>
        <string>/Users/rever/Volumes/TheCloud/backups/llm-logs/cliproxy/m5/live</string>
        <key>CLIPROXY_LOG_MIN_AGE_SECONDS</key>
        <string>3600</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
